# Copy this file to .env and fill in real values. .env is gitignored so
# your real secrets never get committed.

# --- Core -----------------------------------------------------------------
# True only on a developer machine. Production must leave this False.
DJANGO_DEBUG=False
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated hostnames/IPs this server answers to (no scheme, no port).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.96
# Comma-separated full origins (scheme + host + port) that submit forms.
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://192.168.1.96:8000

# --- HTTPS (only once the site really is served over https://) ------------
DJANGO_SECURE_SSL=False
# True when Apache/nginx/Passenger terminates TLS in front of Django.
DJANGO_BEHIND_PROXY=False
DJANGO_HSTS_SECONDS=3600

# --- Database (MySQL/MariaDB) ---------------------------------------------
DB_NAME=compulab_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Lab PC agents ----------------------------------------------------------
# Must exactly match "secret" in every lab PC's lab_pc_agent/agent_config.json.
PC_AGENT_SHARED_SECRET=change-me-and-update-every-agent_config.json
# Background work (PC pinger, auto-lock, log wipe, reminders, email outbox,
# durable jobs, connectivity monitor). True = run it inside the web process
# (single-process setups). On the on-campus server installed with
# installer\server\install-server.ps1 this is False, because the separate
# "CompuLab Worker" service (manage.py run_worker) does it instead.
COMPULAB_BACKGROUND_TASKS=True
# host:port the connectivity monitor connects to (TCP only) to decide whether
# the campus has internet. Change if outbound traffic to it is blocked.
# COMPULAB_INTERNET_PROBE=1.1.1.1:443

# --- In-person account codes (work without internet) -----------------------
# Lifetime of the one-time codes an Admin hands over in person.
# ACTIVATION_CODE_HOURS=72
# RESET_CODE_MINUTES=60

# --- Optional cloud sync (blank = disabled) ---------------------------------
# One-way publishing to a cloud copy; nothing is queued unless BOTH are set.
# The receiving side is NOT part of this project: a receiver implementing
# cloud_sync/PROTOCOL.md must exist at CLOUD_SERVER_URL first. While blank,
# System status says "cloud synchronization not configured" and everything
# works locally. After setting them: restart the services, then run
#   python manage.py cloud_sync_backfill --yes
CLOUD_SERVER_URL=
CLOUD_SYNC_API_KEY=
# Stable name of this campus server on the receiver. Never change it after
# the first sync.
# CLOUD_SYNC_SITE_ID=dtc-main
# Which records are published (comma-separated): reservation, session,
# issue, activity_log, notification.
# CLOUD_SYNC_OBJECT_TYPES=reservation,session,issue
# CLOUD_SYNC_TIMEOUT_SECONDS=5

# --- Optional remote access through Tailscale (blank = campus network only) -
# Set by installer\server\configure-remote-access.ps1, e.g.
# https://compulab-server.your-tailnet.ts.net (Serve mode) or
# http://100.x.y.z:8000 (Direct mode). Its host is accepted automatically
# (ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS); SITE_URL stays the campus address.
COMPULAB_REMOTE_URL=
# Port the CompuLab Web service listens on (written by install-server.ps1).
# COMPULAB_PORT=8000

# --- Optional paths ---------------------------------------------------------
# DJANGO_STATIC_ROOT=/home/USER/public_html/static
# DJANGO_MEDIA_ROOT=/home/USER/compulab_media
# DJANGO_LOG_DIR=/home/USER/logs
# Set False when the web server itself serves MEDIA_ROOT/avatars/.
DJANGO_SERVE_MEDIA=True
# Log file name inside DJANGO_LOG_DIR (the worker service uses worker.log).
# DJANGO_LOG_FILE_NAME=compulab.log

# --- Outgoing email (SMTP) --------------------------------------------------
# Leave EMAIL_HOST_USER/EMAIL_HOST_PASSWORD blank to print emails to the
# console instead of sending them. Never set EMAIL_USE_TLS and
# EMAIL_USE_SSL both to True.
#
# Production (MochaHost cPanel mailbox — values from cPanel > Email Accounts
# > Connect Devices; password is the mailbox's own password):
#   EMAIL_HOST=mail.your-domain.example
#   EMAIL_PORT=465
#   EMAIL_USE_SSL=True
#   EMAIL_USE_TLS=False
#
# Gmail alternative: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_USE_TLS=True, EMAIL_USE_SSL=False, and EMAIL_HOST_PASSWORD must be a
# 16-character App Password (https://myaccount.google.com/apppasswords,
# needs 2-Step Verification), not the normal Gmail login password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.your-domain.example
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=noreply@your-domain.example
EMAIL_HOST_PASSWORD=your-mailbox-password
# Must be the same mailbox as EMAIL_HOST_USER; a display name is allowed.
DEFAULT_FROM_EMAIL=CompuLab <noreply@your-domain.example>
SERVER_EMAIL=noreply@your-domain.example

# The campus (LAN) address of this server: used in links inside emails,
# in each lab PC's Agent config, and shown on System status. Use the
# server's fixed LAN IP + port (http://192.168.1.96:8000), or the public
# https:// domain on a hosted install. Its host is accepted automatically.
SITE_URL=http://192.168.1.96:8000
