# Secrets — never commit these
.env
# ...nor copies of it (.env.bak, .env.production, env-original.txt), saved
# permissions or database credential files; the template stays tracked
.env.*
!.env.example
env-original*.txt
*.sddl
db-admin.cnf
lab_pc_agent/agent_config.local.json
lab_pc_agent/pending_callbacks.json*
lab_pc_agent/agent_status.json*

# Server installer: downloaded service wrapper, generated services, backups
installer/server/bin/*.exe
/service/
/backups/

# Python
__pycache__/
*.pyc
venv/
env/

# Django
db.sqlite3
db.sqlite3.backup
server_log.txt
staticfiles/
logs/
.django_cache/

# Private data: uploaded avatars, activity-log backups, data dumps
media/
data.json
data_backup.json
*.sql

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
# Installer build output and tools (installer/build/build-installers.ps1)
installer/build/.venv/
installer/build/work/
installer/build/tools/
installer/dist/
installer/server/wheels/

# Local simulated-cloud demo databases and logs
.local_remote_demo/

/.venv_python312_backup/
